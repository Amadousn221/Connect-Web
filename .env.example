# ─────────────────────────────────────────────────────────────────────────────
# Connect Web — variables d'environnement
# Copier en `.env.local` et renseigner. `.env.local` n'est jamais versionné.
# Ce fichier `.env.example` EST versionné : n'y mettre AUCUNE valeur secrète,
# uniquement des placeholders vides (les valeurs publiques sont tolérées).
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity (Headless CMS — DÉCISION 25) ──────────────────────────────────────
# Project ID et dataset sont publics (exposés côté navigateur).
NEXT_PUBLIC_SANITY_PROJECT_ID=qt5dnwqm
NEXT_PUBLIC_SANITY_DATASET=production

# Token de LECTURE (rôle "Viewer") — sert uniquement au preview des brouillons
# (draft mode, Étape 3). Laisser vide tant que le draft mode n'est pas branché :
# le dataset `production` est public, la lecture publique fonctionne sans token.
SANITY_API_READ_TOKEN=

# Secret partagé Sanity ↔ Next.js pour le webhook de revalidation ISR
# (route /api/revalidate, Étape 3). Générer une valeur aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANITY_REVALIDATE_SECRET=

# ── Formulaire de contact (déjà branché — voir app/api/contact/route.ts) ─────
# Laisser vide dégrade proprement (la demande est seulement journalisée).
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@connect-web.tech
CONTACT_FROM_EMAIL=Connect Web <site@connect-web.tech>
HUBSPOT_ACCESS_TOKEN=

# ── Divers ──────────────────────────────────────────────────────────────────
# URL publique du site (balises canoniques / hreflang, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Legacy ──────────────────────────────────────────────────────────────────
# Les variables WORDPRESS_* (headless WordPress + WPGraphQL) sont obsolètes
# depuis la DÉCISION 25 (bascule vers Sanity). Le code `lib/wordpress/` reste
# présent mais dormant ; il sera retiré dans une étape ultérieure.
