# ─────────────────────────────────────────────────────────────────────────────
# Connect Web — variables d'environnement
# Copier en `.env.local` et renseigner. Aucune de ces valeurs n'est versionnée.
# ─────────────────────────────────────────────────────────────────────────────

# ── WordPress headless (Hostinger) — requis à partir du Milestone M1 ──────────
# URL complète de l'endpoint WPGraphQL de l'instance WordPress.
# Format attendu : https://cms.connect-web.tech/graphql
WORDPRESS_API_URL=

# Hostname seul de la même instance, pour l'allowlist next/image (next.config.mjs).
# Format attendu : cms.connect-web.tech
WORDPRESS_IMAGE_HOSTNAME=

# Auth application-password WordPress pour les requêtes authentifiées
# (mode preview / brouillons). Laisser vide si seul le contenu publié est lu.
# Format : "utilisateur:xxxx xxxx xxxx xxxx xxxx xxxx" encodé plus bas si besoin.
WORDPRESS_AUTH_USER=
WORDPRESS_AUTH_APP_PASSWORD=

# ── Revalidation ISR à la demande — requis au Milestone M3 ───────────────────
# Secret partagé WordPress ↔ Next.js. La route /api/revalidate rejette toute
# requête non signée avec ce secret. Générer une valeur aléatoire longue.
REVALIDATE_SECRET=

# ── Divers ──────────────────────────────────────────────────────────────────
# URL publique du site (utilisée pour les balises canoniques / hreflang, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
